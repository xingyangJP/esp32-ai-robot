# Copy to .env (git-ignored) and fill in your own values.
RELAY_URL=wss://YOUR-RELAY.a.run.app        # your Cloud Run relay (Remote mode)
GCP_PROJECT_ID=YOUR-GCP-PROJECT
GCP_PROJECT_NUMBER=YOUR-PROJECT-NUMBER
GCP_ACCOUNT=you@example.com
APPLE_TEAM_ID=YOURTEAMID                     # Xcode > Signing
BUNDLE_ID=com.example.robotbrainai
HOME_WIFI_SSID=YOUR_WIFI_SSID
CAR_IP=192.168.1.123                         # or use mDNS robotbrain.local
